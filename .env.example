# NetPilot collector 环境变量（仅存 NAS 本地，禁止提交 git）
# 用法：cp .env.example .env 后填真值

# ── 令牌（openssl rand -hex 16 生成；读令牌给看板/查询，写令牌给控制/修复）──
NETPILOT_READ_TOKEN=
NETPILOT_WRITE_TOKEN=

# ── R68S 旁路由 ──
MIHOMO_SECRET=JNuFXab5
R68S_SSH_PASSWORD=password

# ── 服务 ──
NETPILOT_PORT=8898
NETPILOT_DB=/data/netpilot.db
NETPILOT_TZ=Asia/Shanghai

# ── M2 agent 上报令牌（agents 三端脚本携带；openssl rand -hex 16 生成）──
AGENT_TOKEN=

# ── M2 通知渠道（NOTIFY_PROVIDER 选一；留空/none=只落库不推送）──
NOTIFY_PROVIDER=none
# Bark(iOS): https://api.day.app/<key>
NOTIFY_BARK_URL=
# ntfy: https://ntfy.sh/<topic>
NOTIFY_NTFY_URL=
# Telegram
NOTIFY_TG_TOKEN=
NOTIFY_TG_CHATID=
# 任意 webhook（POST JSON {title,message,severity}）
NOTIFY_WEBHOOK_URL=
# 同一告警的重复通知冷却（分钟）
NOTIFY_COOLDOWN_MIN=30
